@{
    ViewData["Title"] = "Upload Dataset";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1">Upload Dataset</h2>
            <div class="text-muted">Upload a dataset to generate profiling, charts, and AI insights.</div>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="Projects" asp-action="Index">
            Back to Projects
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Upload" asp-controller="Datasets" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label fw-semibold">CSV or Excel File</label>
                    <input class="form-control" type="file" name="file" accept=".csv,.xlsx" required />
                    <div class="form-text">
                        Tip: Use small files first (a few hundred rows) while building.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Project (optional for now)</label>
                    <select class="form-select" name="projectId" disabled>
                        <option selected>Coming soon (Projects feature)</option>
                    </select>
                    <div class="form-text">
                        You’ll later upload into a Project to organize datasets and reports.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Upload
                    </button>
                    <button type="reset" class="btn btn-light">
                        Clear
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-4">
        <h5 class="mb-2">What happens after upload?</h5>
        <ul class="text-muted mb-0">
            <li>We calculate basic profiling (rows, columns, missing values)</li>
            <li>We show a preview table and charts</li>
            <li>AI generates insights (no raw full data by default)</li>
        </ul>
    </div>
</div>
@if (TempData["UploadError"] != null)
{
    <div class="modal fade" id="uploadErrorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Can't analyze this file</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@TempData["UploadError"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('uploadErrorModal');
            if (el && window.bootstrap) {
                new bootstrap.Modal(el).show();
            }
        });
    </script>
}
