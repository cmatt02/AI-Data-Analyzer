@model DatasetDetailsViewModel

@{
    ViewData["Title"] = "Dataset Details";
    var previewLines = Model?.PreviewLines ?? new List<string>();
}

<div class="container py-4" style="max-width: 1100px;">
    <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
        <div>
            <h2 class="mb-1">Dataset</h2>
            <div class="text-muted">@Model.OriginalFileName</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Datasets" asp-action="Upload">
                Upload Another
            </a>
            <button id="generateReportBtn" class="btn btn-outline-primary" type="button">
                Generate Report
            </button>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Rows</div>
                    <div class="fs-3 fw-semibold">@Model.RowCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Columns</div>
                    <div class="fs-3 fw-semibold">@Model.ColumnCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">File</div>
                    <div class="fw-semibold text-truncate">@Model.OriginalFileName</div>
                    <div class="small text-muted">Processed in memory — not saved on the server.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Left: Data preview + charts -->
        <div class="col-lg-8">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="fw-semibold">Preview</div>
                        <span class="badge text-bg-light">First rows</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <tbody>
                                @if (previewLines.Count == 0)
                                {
                                    <tr><td class="text-muted p-4">No preview data yet.</td></tr>
                                }
                                else
                                {
                                    foreach (var line in previewLines)
                                    {
                                        <tr>
                                            @foreach (var cell in line.Split(Model.Delimiter))
                                            {
                                                <td>@cell</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <div class="fw-semibold">Charts</div>
                    <div class="small text-muted">Auto charts (Chart.js)</div>
                </div>
                <div class="card-body">

                    @if (Model.NumericColumns != null && Model.NumericColumns.Any() && Model.NumericSeries != null && Model.NumericSeries.Any())
                    {
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="fw-semibold">Line Chart</div>

                            <select id="chartColumnSelect" class="form-select form-select-sm" style="max-width: 220px;">
                                @foreach (var col in Model.NumericColumns)
                                {
                                    <option value="@col" selected="@(col == Model.SelectedChartColumn)">
                                        @col
                                    </option>
                                }
                            </select>
                        </div>

                        <div style="height:260px;">
                            <canvas id="mainChart"></canvas>
                        </div>

                        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                        <script>
                            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SeriesLabels));
                            const series = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NumericSeries));
                            const initialColumn = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedChartColumn));

                            const ctx = document.getElementById('mainChart');
                            let chart;

                            function renderChart(columnName) {
                            const values = series[columnName] || [];

                            if (chart) chart.destroy();

                            chart = new Chart(ctx, {
                            type: 'line',
                            data: {
                            labels: labels,
                            datasets: [{
                            label: columnName,
                            data: values,
                            tension: 0.25
                            }]
                            },
                            options: {
                            responsive: true,
                            maintainAspectRatio: false
                            }
                            });
                            }

                            // initial render
                            renderChart(initialColumn);

                            // expose current chart as an image for the report generator
                            window.__getChartImage = function () {
                                try { return chart ? chart.toBase64Image() : null; }
                                catch (e) { return null; }
                            };

                            // dropdown change
                            document.getElementById('chartColumnSelect').addEventListener('change', (e) => {
                            renderChart(e.target.value);
                            });
                        </script>
                    }
                    else
                    {
                        <div class="text-muted">No numeric data available for charting yet.</div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: AI Insights panel -->
        <div class="col-lg-4">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="fw-semibold mb-2">Dataset Profile</div>

                    <div class="mb-2">
                        <strong>Total Missing Values:</strong> @Model.TotalMissingValues
                    </div>

                    <div class="mb-2">
                        <strong>Numeric Columns:</strong>
                        @string.Join(", ", Model.NumericColumns)
                    </div>

                    <div>
                        <strong>Text Columns:</strong>
                        @string.Join(", ", Model.TextColumns)
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <div class="fw-semibold">AI Insights</div>
                    <div class="small text-muted">Summaries, anomalies, next steps</div>
                </div>
                <div class="card-body">
                    <button id="generateInsightsBtn" class="btn btn-primary w-100 mb-2" type="button">
                        Generate Insights
                    </button>
                    <div class="small text-muted">
                        By default, we’ll send only dataset summaries and small samples to the AI (not the full raw file).
                    </div>

                    <hr />

                    <div id="insightsStatus" class="text-muted">
                        No insights yet. Click “Generate Insights”.
                    </div>
                    <div id="insightsOutput" class="mt-2" style="white-space: pre-wrap;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>
    <script>
        (function () {
            const btn = document.getElementById('generateInsightsBtn');
            if (!btn) return;

            const statusEl = document.getElementById('insightsStatus');
            const outEl = document.getElementById('insightsOutput');

            // Profile data serialized from the server-side model.
            const payload = {
                fileName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OriginalFileName)),
                rowCount: @Model.RowCount,
                columnCount: @Model.ColumnCount,
                totalMissingValues: @Model.TotalMissingValues,
                numericColumns: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NumericColumns)),
                textColumns: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TextColumns)),
                missingValuesPerColumn: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MissingValuesPerColumn)),
                sampleRows: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PreviewLines))
                };

            btn.addEventListener('click', async function () {
            btn.disabled = true;
            statusEl.textContent = 'Generating insights…';
            outEl.textContent = '';

            try {
                const resp = await fetch('@Url.Action("Generate", "Insights")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await resp.json();

            if (!resp.ok) {
                statusEl.textContent = (data && data.error) ? data.error : 'Could not generate insights.';
                return;
            }

            statusEl.textContent = 'Insights:';
            outEl.innerHTML = DOMPurify.sanitize(marked.parse(data.insights));
                } catch (e) {
                    statusEl.textContent = 'Network error. Please try again.';
                } finally {
                    btn.disabled = false;
                }
            });
        })();

        (function () {
            const reportBtn = document.getElementById('generateReportBtn');
            if (!reportBtn) return;

            // Profile data from the server-side model.
            const report = {
                fileName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OriginalFileName)),
                rowCount: @Model.RowCount,
                columnCount: @Model.ColumnCount,
                totalMissing: @Model.TotalMissingValues,
                numericColumns: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NumericColumns)),
                textColumns: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TextColumns)),
                missingPerColumn: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MissingValuesPerColumn))
            };

            function esc(s) {
                return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
                                .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            reportBtn.addEventListener('click', function () {
                // Snapshot the current chart, if one exists.
                let chartImg = null;
                if (typeof window.__getChartImage === 'function') {
                    chartImg = window.__getChartImage();
                }

                // Reuse insights only if the user already generated them.
                const insightsEl = document.getElementById('insightsOutput');
                const insightsHtml = (insightsEl && insightsEl.innerHTML.trim().length > 0)
                    ? insightsEl.innerHTML
                    : '';
                const hasInsights = insightsHtml.length > 0;

                const missingRows = Object.keys(report.missingPerColumn).map(k =>
                    `<tr><td>${esc(k)}</td><td>${esc(report.missingPerColumn[k])}</td></tr>`
                ).join('');

                const generatedAt = new Date().toLocaleString();

                const html = `
                    <!doctype html>
                    <html>
                    <head>
                    <meta charset="utf-8">
                    <title>Report — ${esc(report.fileName)}</title>
                    <style>
                      body { font-family: Segoe UI, Arial, sans-serif; color: #222; margin: 32px; }
                      h1 { font-size: 22px; margin-bottom: 4px; }
                      h2 { font-size: 15px; margin-top: 28px; border-bottom: 1px solid #ddd; padding-bottom: 4px; }
                      .muted { color: #666; font-size: 12px; }
                      table { border-collapse: collapse; margin-top: 8px; font-size: 13px; }
                      td, th { border: 1px solid #ddd; padding: 4px 10px; text-align: left; }
                      .stat { display: inline-block; margin-right: 24px; font-size: 13px; }
                      .stat b { font-size: 18px; display: block; }
                      img { max-width: 100%; border: 1px solid #eee; margin-top: 8px; }
                      .insights { font-size: 13px; line-height: 1.5; }
                      @@media print { body { margin: 0; } }
                    </style>
                    </head>
                    <body>
                      <h1>Dataset Report</h1>
                      <div class="muted">${esc(report.fileName)} · generated ${esc(generatedAt)}</div>

                      <h2>Overview</h2>
                      <span class="stat"><b>${report.rowCount}</b> rows</span>
                      <span class="stat"><b>${report.columnCount}</b> columns</span>
                      <span class="stat"><b>${report.totalMissing}</b> missing values</span>

                      <h2>Columns</h2>
                      <div style="font-size:13px;">
                        <b>Numeric:</b> ${report.numericColumns.map(esc).join(', ') || '—'}<br>
                        <b>Text:</b> ${report.textColumns.map(esc).join(', ') || '—'}
                      </div>

                      <h2>Missing values per column</h2>
                      <table><tr><th>Column</th><th>Missing</th></tr>${missingRows}</table>

                      ${chartImg ? `<h2>Chart</h2><img src="${chartImg}" alt="chart">` : ''}

                      <h2>AI Insights</h2>
                      ${hasInsights ? `<div class="insights">${insightsHtml}</div>`
                                    : `<div class="muted">No AI insights were generated for this dataset.</div>`}
                    </` + `body>
                    </` + `html>`;

                const w = window.open('', '_blank');
                if (!w) {
                    alert('Please allow pop-ups to generate the report.');
                    return;
                }

                const blob = new Blob([html], { type: 'text/html' });
                const url = URL.createObjectURL(blob);
                w.location = url;

                // Give the chart image a moment to load before printing.
                w.onload = function () {
                    setTimeout(function () {
                        w.print();
                        URL.revokeObjectURL(url);
                    }, 300);
                };
            });
        })();
    </script>
}
